# DevPulse AI - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# IBM watsonx AI Configuration
# ============================================
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key_here

# Get your project ID from: https://dataplatform.cloud.ibm.com/
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ============================================
# GitHub Configuration
# ============================================
# Create a personal access token at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=ghp_your_github_token_here

# Demo repository URL for testing
# Example: https://github.com/username/repository
DEMO_REPO_URL=https://github.com/your-username/your-demo-repo

# GitHub Webhook Secret (for PR Guardian automated reviews)
# Set this in your GitHub webhook settings: https://github.com/user/repo/settings/hooks
# Generate a random secret string for security
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# Slack Integration (Optional)
# ============================================
# Create an incoming webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel for notifications (optional)
SLACK_CHANNEL=#devpulse-alerts

# ============================================
# Flask Configuration
# ============================================
# Flask environment: development, production, testing
FLASK_ENV=development

# Flask debug mode: True or False
FLASK_DEBUG=True

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
FLASK_HOST=127.0.0.1

# Server port
FLASK_PORT=5000

# Secret key for session management (generate a random string)
FLASK_SECRET_KEY=your-secret-key-change-this-in-production

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# ============================================
# AI Model Configuration
# ============================================
# Model ID to use (default: ibm/granite-34b-code-instruct)
WATSONX_MODEL_ID=ibm/granite-34b-code-instruct

# Maximum tokens for AI responses
MAX_TOKENS=4000

# Temperature for AI responses (0.0 - 1.0, lower = more deterministic)
AI_TEMPERATURE=0.1

# ============================================
# Repository Ingestion Configuration
# ============================================
# Maximum number of files to fetch from repository
MAX_REPO_FILES=50

# Maximum characters per file (files will be truncated)
MAX_FILE_SIZE=2000

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty to log to console only)
LOG_FILE=logs/devpulse.log

# ============================================
# Cache Configuration (Optional)
# ============================================
# Enable caching for repository contexts
ENABLE_CACHE=True

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Redis URL (if using Redis for caching)
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Rate Limiting (Optional)
# ============================================
# Enable rate limiting
ENABLE_RATE_LIMIT=False

# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Feature Flags
# ============================================
# Enable/disable specific modules
ENABLE_CODE_CONTEXT=True
ENABLE_PR_GUARDIAN=True
ENABLE_INCIDENT_WHISPERER=True
ENABLE_DEBT_RADAR=True

# ============================================
# Development/Testing
# ============================================
# Enable mock mode (uses fake data instead of real API calls)
MOCK_MODE=False

# Test repository for development
TEST_REPO_URL=https://github.com/octocat/Hello-World