# DevPulse AI - Environment Configuration

# ── IBM watsonx (Bob) — REQUIRED for AI features ──────────────────────────────
# Get API key:    https://cloud.ibm.com/iam/apikeys
# Get project ID: https://dataplatform.cloud.ibm.com/ → your project → Manage → Details
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_MODEL_ID=ibm/granite-34b-code-instruct

# ── GitHub — optional but avoids rate limits ──────────────────────────────────
# Create at: https://github.com/settings/tokens  (scope: public_repo)
GITHUB_TOKEN=ghp_your_token_here

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=true
